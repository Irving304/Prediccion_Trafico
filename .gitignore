# ==========================================
# Entornos Virtuales
# ==========================================
venv/
.venv/
env/
ENV/

# ==========================================
# Secretos y Variables de Entorno (APIs)
# ==========================================
.env
.env.*
*.env

# ==========================================
# Empaquetado y Construcción (setuptools / pip)
# ==========================================
*.egg-info/
build/
dist/
.eggs/

# ==========================================
# Datos, Artefactos y Cache Espacial
# ==========================================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
cache/

# Archivos pesados de datos y capas espaciales
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.geojson
*.gpkg
*.osm

# ==========================================
# Modelos, Checkpoints y Serialización
# ==========================================
models/*
!models/.gitkeep
*.pt
*.pth
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.onnx

# ==========================================
# Python, Cache y Logs
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class
*.log
logs/
.pytest_cache/
.coverage

# ==========================================
# IDEs y Entornos de Desarrollo
# ==========================================
.vscode/
.idea/
.ipynb_checkpoints/

# ==========================================
# Sistema Operativo
# ==========================================
Thumbs.db
desktop.ini
.DS_Store
